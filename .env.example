# ==============================================================================
# LEGAAS — Exemplo de variáveis de ambiente
# Copie este arquivo para `.env` (em desenvolvimento) e ajuste os valores.
# NUNCA versione `.env` ou segredos reais no repositório (CLAUDE.md §11).
# ==============================================================================

NODE_ENV=development

# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Banco de Dados (PostgreSQL com Row-Level Security)
# - DATABASE_OWNER_URL: role dona do schema (`legaas_owner`), usada APENAS em
#   migrations/DDL. Possui privilégios de criação/alteração de tabelas e políticas.
# - DATABASE_URL: role da aplicação (`legaas_app`), SEM BYPASSRLS e sem ownership.
#   Toda query de runtime passa obrigatoriamente pelas políticas RLS.
# ------------------------------------------------------------------------------
DATABASE_OWNER_URL=postgresql://legaas_owner:legaas_owner_dev_password@localhost:5432/legaas_dev
DATABASE_URL=postgresql://legaas_app:legaas_app_dev_password@localhost:5432/legaas_dev

# ------------------------------------------------------------------------------
# Autenticação (Better Auth)
# Gere em produção com: openssl rand -base64 32
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=dev-only-secret-replace-in-production-32chars
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Storage de Documentos (compatível com S3 — MinIO local / AWS S3 sa-east-1)
# Bucket sempre PRIVADO; acesso via URL pré-assinada de curta duração.
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=sa-east-1
S3_BUCKET=legaas-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# E-mail transacional (Mailpit local em dev)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@legaas.local

# ------------------------------------------------------------------------------
# IA — Extração Inteligente de Certidões e Validades (Groq API)
# Opcional em desenvolvimento (possui motor determinístico de fallback Regex).
# Obtenha sua chave em: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Observabilidade
# ------------------------------------------------------------------------------
LOG_LEVEL=info
